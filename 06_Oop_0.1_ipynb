    {
      "cell_type": "code",
      "source": [
        "# __init__()\n",
        "# __init__() --> is built-in method which is always executed when the class gets initiated (object is being getting created)"
      ],
      "metadata": {
        "id": "ag3DcoUPLhGi"
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "class Person:\n",
        " def __init__(self, name, city):\n",
        "  self.name = name\n",
        "  self.city = city"
      ],
      "metadata": {
        "id": "lhO41K6FLlI0"
      },
      "execution_count": 14,
      "outputs": []
    },
