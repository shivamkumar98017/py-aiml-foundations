    {
      "cell_type": "markdown",
      "source": [
        "Object Oriented Programming (OOP) using Python"
      ],
      "metadata": {
        "id": "sQifYbeeKvtQ"
      }
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {
        "id": "TlH3rxHbKtd6"
      },
      "outputs": [],
      "source": [
        "# Class --> Blueprint\n",
        "# Object --> specific instance of that class\n",
        "# eg:\n",
        "# Class --> Car\n",
        "# object --> Volvo, BMW, Suzuki\n",
        "# object --> methods and its properties"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "class ClassName:\n",
        " x = 10"
      ],
      "metadata": {
        "id": "HbTFKjizK5y_"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "p1 = ClassName()\n",
        "print(p1.x)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "VkOFQcfwK-Oe",
        "outputId": "75c8b17e-4fae-4a28-d9e4-129324357313"
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "10\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "p2 = ClassName()\n",
        "print(p2.x)\n",
        "p3 = ClassName()\n",
        "print(p3.x)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "FZtJ_pWvLBn-",
